      "optional": true
    },
    "lucide-react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "lucide-react": "^0.525.0",
    "lucide-react-native": "^0.525.0",
    "react": "^19.0.0",
