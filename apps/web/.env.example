# --- Required ---
# Backend origin the Next.js server proxies /api/* to (no localhost fallback exists).
# Read at build time by next.config.ts. On Railway use the private URL: http://backend.railway.internal:3001
BACKEND_URL=http://localhost:3001
# Public site URL (used for OpenGraph / metadataBase)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Exact "campaign" locks the public site to /launch (marketplace routes and account auth redirect there).
# Any other value keeps the marketplace open at / with the campaign still available at /launch.
# Backend intake, phase, and membership checks remain authoritative.
KAYOU_PUBLIC_WEB_MODE=marketplace
# Must match the current server-accepted notice version before campaign launch.
NEXT_PUBLIC_CAMPAIGN_PRIVACY_NOTICE_VERSION=campaign-2026-07-25
# Public withdrawal/correction channel displayed beside campaign consent.
NEXT_PUBLIC_CAMPAIGN_PRIVACY_CONTACT=confidentialite@kayou.cd
# Shared Supabase project (anon key is public/safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
