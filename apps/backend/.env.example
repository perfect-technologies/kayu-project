# --- Required secrets ---
# App database. Local Docker Postgres (compose.yaml, port 5433) in dev and CI.
# Hosted envs (Railway): Supabase transaction pooler string, port 6543, with ?pgbouncer=true&connection_limit=10
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/kayu?schema=public
# Supabase session pooler string (port 5432) used by Prisma CLI for migrate deploy.
# Optional: defaults to DATABASE_URL when empty (local dev and CI).
DIRECT_URL=
# Shared Supabase project (same for dev and prod)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SERVICE_KEY=<service-role-key>
# Agent concierge (/assistant): Vercel AI Gateway key, the only model credential. Turns fail with a streamed error while unset.
AI_GATEWAY_API_KEY=<ai-gateway-api-key>
# Optional gateway model id override; defaults to anthropic/claude-opus-5 (docs/ai-agents/RFC-001 §11).
AGENT_MODEL_ID=
# Jev (TypeSafe): search interpretation on /rechercher when the feat_jev_search setting is on, and `pnpm jev:eval`. docs/ai-jev/.
TYPESAFE_API_KEY=

# --- Config (non-secret) ---
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# Per-environment storage namespace in the shared Supabase bucket: dev | prod (empty = no prefix)
STORAGE_ENV_PREFIX=
# Local-only demo seeding into shared Supabase auth. Keep false everywhere except a local seed run.
SEED_SUPABASE_USERS=false

# Public campaign lead intake is independent from beta access. Keep disabled until
# the current privacy notice/version and a secret hash key are configured.
LAUNCH_PUBLIC_INTAKE_ENABLED=false
LAUNCH_FUNNEL_EVENTS_ENABLED=false
LAUNCH_PRIVACY_NOTICE_VERSION=
LAUNCH_RATE_LIMIT_HASH_KEY=
LAUNCH_INTAKE_IP_LIMIT=20
LAUNCH_FUNNEL_EVENT_IP_LIMIT=120
LAUNCH_INTAKE_CONTACT_LIMIT=5
LAUNCH_INTAKE_RATE_WINDOW_SECONDS=900
LAUNCH_INTAKE_MAX_BODY_BYTES=16384
LAUNCH_INTAKE_RATE_BUCKET_CAPACITY=10000

# --- Test only ---
# Registers the test-only session hook POST /api/test/session for the Playwright suite.
# Never enable in production: the env validator rejects E2E_TEST_MODE=true with NODE_ENV=production.
E2E_TEST_MODE=false
# Password the hook signs seeded demo accounts in with (Password123! after pnpm db:seed).
E2E_SEED_PASSWORD=
