{
  "name": "@kayu/backend",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/main.js",
  "scripts": {
    "dev": "nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "build": "nest build",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test:identity": "node --test -r ts-node/register src/modules/identity/identity.service.spec.ts",
    "test:bookings": "node --test -r ts-node/register src/modules/bookings/bookings.service.spec.ts",
    "test:messaging": "node --test -r ts-node/register src/modules/messaging/messaging.service.spec.ts",
    "test:quotes": "node --test -r ts-node/register src/modules/quotes/quotes.service.spec.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:reset": "prisma db push --force-reset && pnpm run db:seed",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "lint": "echo 'no linter configured'",
    "clean": "rm -rf dist"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@kayu/schemas": "workspace:*",
    "@kayu/utils": "workspace:*",
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.17",
    "@nestjs/platform-express": "^11.1.17",
    "@prisma/client": "^6.19.2",
    "cookie-parser": "^1.4.7",
    "jose": "^6.1.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.5",
    "@types/node": "^22.18.10",
    "prisma": "^6.19.2",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.0"
  }
}
